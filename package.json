{
  "name": "yanzhi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Papernook local research edition: personal notes and PDF provenance",
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo": "node --import tsx scripts/demo.ts",
    "release:check": "node scripts/release-check.mjs",
    "dev": "node scripts/serve.mjs dev",
    "start": "node scripts/serve.mjs start",
    "build": "node scripts/assets.mjs && next build --webpack && node scripts/trim-build-cache.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:http": "node scripts/http-smoke.mjs",
    "test:codex": "node scripts/codex-smoke.mjs",
    "test:guide": "node --import tsx scripts/guide-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@uiw/react-codemirror": "4.25.12",
    "katex": "0.19.0",
    "lucide-react": "1.59.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "undici": "8.12.2",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "pdf-lib": "1.17.1"
  }
}
