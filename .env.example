# Relative paths resolve from app/local. Never point this at Zotero's data directory.
KB_DATA_DIR=./data
# Blank selects the provider from Settings. Set none to explicitly disable AI.
KB_AI_PROVIDER=
KB_OLLAMA_URL=http://127.0.0.1:11434
KB_OLLAMA_MODEL=
# Optional OpenAI-compatible endpoint; keys are server-only and excluded from backup.
KB_OPENAI_URL=
KB_OPENAI_MODEL=
KB_OPENAI_API_KEY=
# Optional local Codex CLI. Uses its own saved login; do not copy auth.json here.
# Select codex in Settings, or set KB_AI_PROVIDER=codex above.
# Blank prefers the Codex app's CLI when available, then codex on PATH.
KB_CODEX_BIN=
# Blank uses the Settings model, then the CLI default; chats can override per question.
KB_CODEX_MODEL=
# Non-streaming Codex tasks only: 100..300000 ms; default 180000.
# Does not limit paper/idea chat. Connection checks retain their own shorter limit.
KB_CODEX_TIMEOUT_MS=180000
# Streaming paper/idea chat: 0 or blank means no application total deadline.
# A positive value explicitly opts into a total deadline in milliseconds, without a 5-minute clamp.
# Server/proxy shutdown or provider limits can still interrupt a request.
KB_CHAT_TIMEOUT_MS=0
# Only needed for source PDF text extraction. Default executable: pdftotext.
KB_PDFTOTEXT=pdftotext
NEXT_TELEMETRY_DISABLED=1
